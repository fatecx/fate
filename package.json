{
  "name": "fate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/gen-brand-icons.mjs",
    "sim": "esbuild scripts/sim/run.ts --bundle --platform=node --format=esm --outfile=/tmp/fate-sim.mjs && node /tmp/fate-sim.mjs",
    "sim:llm": "esbuild scripts/sim/llm.ts --bundle --platform=node --format=esm --outfile=/tmp/fate-sim-llm.mjs && node /tmp/fate-sim-llm.mjs",
    "tauri": "tauri",
    "map": "esbuild scripts/map/generate.ts --bundle --platform=node --format=esm --outfile=/tmp/fate-map-gen.mjs && node /tmp/fate-map-gen.mjs",
    "script": "esbuild scripts/script/generate.ts --bundle --platform=node --format=esm --outfile=/tmp/fate-script-gen.mjs && node /tmp/fate-script-gen.mjs",
    "script:apply": "esbuild scripts/script/apply.ts --bundle --platform=node --format=esm --outfile=/tmp/fate-script-apply.mjs && node /tmp/fate-script-apply.mjs",
    "build": "vite build && npm run map && node scripts/map/encrypt.mjs",
    "deploy": "sh scripts/deploy.sh",
    "itch": "node scripts/itch.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/dagre": "^0.7.54",
    "dagre": "^0.8.5",
    "typescript": "^5.6.3",
    "vercel": "^59.5.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@supabase/supabase-js": "^2.112.4"
  }
}
